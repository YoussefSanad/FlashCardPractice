#!/bin/bash

set -e  # Exit on any error

echo "🐳 Laravel Docker Setup Script"
echo "=============================="

# Check if Docker is installed
if ! command -v docker &> /dev/null; then
    echo "❌ Docker is not installed. Please install Docker Desktop from:"
    echo "   https://www.docker.com/products/docker-desktop/"
    exit 1
fi

echo "✅ Docker is installed: $(docker --version)"

# Check if Docker Compose is available
COMPOSE_CMD=""
if command -v docker-compose &> /dev/null; then
    COMPOSE_CMD="docker-compose"
    echo "✅ Docker Compose is available: $(docker-compose --version)"
elif docker compose version &> /dev/null; then
    COMPOSE_CMD="docker compose"
    echo "✅ Docker Compose V2 is available: $(docker compose version)"
else
    echo "❌ Docker Compose is not available. Please install Docker Desktop."
    exit 1
fi

# Check if .env.docker exists
if [ ! -f ".env.docker" ]; then
    echo "❌ .env.docker file not found. Please ensure you're in the project root directory."
    exit 1
fi

echo "✅ .env.docker file found"

# Check for port conflicts
echo "🔍 Checking for port conflicts..."
./docker/scripts/check-ports

# Copy environment configuration
echo "📋 Copying Docker environment configuration..."
cp .env.docker .env
echo "✅ Environment configuration copied"

# Build and start containers
echo "🏗️  Building and starting Docker containers..."
if [ "$COMPOSE_CMD" = "docker-compose" ]; then
    docker-compose up -d --build
else
    docker compose up -d --build
fi

echo "⏳ Waiting for containers to be ready..."
sleep 10

# Check if containers are running
echo "🔍 Checking container status..."
if [ "$COMPOSE_CMD" = "docker-compose" ]; then
    docker-compose ps
else
    docker compose ps
fi

# Install PHP dependencies
echo "📦 Installing PHP dependencies..."
./docker/scripts/composer install
echo "✅ PHP dependencies installed"

# Generate application key if needed
if [ "$GENERATE_KEY" = true ]; then
    echo "🔑 Generating Laravel application key..."
    ./docker/scripts/artisan key:generate
    echo "✅ Application key generated"
fi

# Run migrations
echo "🗄️  Running database migrations..."
./docker/scripts/migrate

# Run tests to verify everything is working
echo "🧪 Running tests to verify setup..."
./docker/scripts/artisan test
echo "✅ All tests passed - setup verified!"

echo ""
echo "🎉 Setup complete!"
echo ""
echo "📋 Next steps:"
echo "   • Start the flashcard app: ./docker/scripts/artisan flashcard:interactive"
echo "   • View logs: $COMPOSE_CMD logs -f"
echo "   • Stop containers: ./docker/scripts/docker-down"
echo ""
echo "🛠️  Available helper scripts:"
echo "   • ./docker/scripts/artisan [command]  - Run Artisan commands"
echo "   • ./docker/scripts/composer [command] - Run Composer commands"
echo "   • ./docker/scripts/migrate           - Run database migrations"
echo "   • ./docker/scripts/tinker            - Start Laravel Tinker" 