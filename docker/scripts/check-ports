#!/bin/bash

echo "🔍 Checking for port conflicts..."

# Ports used by our Docker setup
PORTS=(8080 3307 6380)
PORT_NAMES=("Web Server (Nginx)" "MySQL Database" "Redis Cache")

conflicts=false

for i in "${!PORTS[@]}"; do
    port=${PORTS[$i]}
    name=${PORT_NAMES[$i]}
    
    if lsof -i :$port > /dev/null 2>&1; then
        echo "❌ Port $port is already in use (needed for $name)"
        echo "   Process using port $port:"
        lsof -i :$port | grep LISTEN
        conflicts=true
    else
        echo "✅ Port $port is available ($name)"
    fi
done

if [ "$conflicts" = true ]; then
    echo ""
    echo "⚠️  Port conflicts detected!"
    echo ""
    echo "Solutions:"
    echo "1. Stop the conflicting services:"
    echo "   - For MySQL: sudo brew services stop mysql (if using Homebrew)"
    echo "   - For Redis: sudo brew services stop redis (if using Homebrew)"
    echo "   - Or check what's using the ports with: lsof -i :[PORT]"
    echo ""
    echo "2. Or modify docker-compose.yml to use different external ports"
    echo ""
    exit 1
else
    echo ""
    echo "🎉 All ports are available! You can start the Docker containers."
fi 