#!/bin/bash

echo "🔍 Docker Setup Verification"
echo "============================"

# Check if required files exist
echo "📁 Checking required files..."

required_files=(
    "Dockerfile"
    "docker-compose.yml"
    ".env.docker"
    ".dockerignore"
    "docker/nginx/nginx.conf"
)

for file in "${required_files[@]}"; do
    if [ -f "$file" ]; then
        echo "✅ $file exists"
    else
        echo "❌ $file is missing"
        exit 1
    fi
done

# Check if helper scripts exist and are executable
echo ""
echo "🛠️  Checking helper scripts..."

scripts=(
    "docker/scripts/setup"
    "docker/scripts/docker-up"
    "docker/scripts/docker-down"
    "docker/scripts/artisan"
    "docker/scripts/composer"
    "docker/scripts/migrate"
    "docker/scripts/seed"
    "docker/scripts/tinker"
)

for script in "${scripts[@]}"; do
    if [ -f "$script" ] && [ -x "$script" ]; then
        echo "✅ $script exists and is executable"
    elif [ -f "$script" ]; then
        echo "⚠️  $script exists but is not executable"
        chmod +x "$script"
        echo "✅ Made $script executable"
    else
        echo "❌ $script is missing"
        exit 1
    fi
done

# Check Docker installation
echo ""
echo "🐳 Checking Docker installation..."

if command -v docker &> /dev/null; then
    echo "✅ Docker is installed: $(docker --version)"
else
    echo "❌ Docker is not installed"
    exit 1
fi

# Check Docker Compose
if command -v docker-compose &> /dev/null; then
    echo "✅ Docker Compose is available: $(docker-compose --version)"
elif docker compose version &> /dev/null; then
    echo "✅ Docker Compose V2 is available: $(docker compose version)"
else
    echo "❌ Docker Compose is not available"
    exit 1
fi

# Check if Laravel Sail is removed
echo ""
echo "🧹 Checking Laravel Sail removal..."

if composer show | grep -q sail; then
    echo "❌ Laravel Sail is still present in dependencies"
    exit 1
else
    echo "✅ Laravel Sail has been successfully removed"
fi

echo ""
echo "🎉 All checks passed! Your Docker setup is ready."
echo ""
echo "📋 To get started:"
echo "   1. Run: ./docker/scripts/setup"
echo "   2. Or manually: cp .env.docker .env && ./docker/scripts/docker-up"
echo "   3. Then: ./docker/scripts/migrate"
echo "   4. Finally: ./docker/scripts/artisan flashcard:interactive" 